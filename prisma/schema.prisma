generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guest {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String
  slug       String    @unique
  createdAt  DateTime  @default(now())
  blastedAt  DateTime? // null = belum pernah di-blast
}

model Wish {
  id         Int      @id @default(autoincrement())
  senderName String
  message    String
  attendance String
  createdAt  DateTime @default(now())
}